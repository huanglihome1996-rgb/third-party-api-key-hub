[Unit]
Description=API Key Hub fictional daily backup
Requires=api-key-hub-fixture.service
After=api-key-hub-fixture.service

[Service]
Type=oneshot
User=hubd-fixture
Group=hubd-fixture
UMask=0077
ExecStart=/bin/sh -c 'exec /opt/api-key-hub/bin/hub --socket /var/lib/api-key-hub-fixture/instance/hub.sock < /opt/api-key-hub/deploy/fixture-backup.json'
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitCORE=0
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=journal
