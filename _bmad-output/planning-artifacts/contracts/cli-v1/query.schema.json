{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "identity": {
      "type": "object",
      "properties": {
        "app_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s|\\x00-\\x1f\\x7f]+$"
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s|\\x00-\\x1f\\x7f]+$"
        },
        "provider_app_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s|\\x00-\\x1f\\x7f]+$"
        },
        "external_shop_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s|\\x00-\\x1f\\x7f]+$"
        },
        "provider_shop_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s|\\x00-\\x1f\\x7f]+$"
        },
        "brand_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s|\\x00-\\x1f\\x7f]+$"
        },
        "internal_shop_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s|\\x00-\\x1f\\x7f]+$"
        }
      },
      "required": [
        "app_id",
        "platform",
        "provider_app_id",
        "external_shop_id",
        "provider_shop_id",
        "brand_id",
        "internal_shop_id"
      ],
      "additionalProperties": true
    },
    "credentials": {
      "type": "object",
      "properties": {
        "app": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "const": "client_secret"
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "shop": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "const": "shop_token"
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "app",
        "shop"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "properties": {
        "app": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "const": "client_secret"
              },
              "generation": {
                "type": "integer",
                "minimum": 1
              },
              "row_revision": {
                "type": "integer",
                "minimum": 1
              },
              "available": {
                "const": true
              },
              "disabled": {
                "const": false
              },
              "confirmed_by_operator": {
                "type": "boolean"
              },
              "expiry_known": {
                "type": "boolean"
              },
              "expires_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "type",
              "generation",
              "available",
              "expiry_known",
              "expires_at"
            ],
            "additionalProperties": true
          }
        },
        "shop": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "const": "shop_token"
              },
              "generation": {
                "type": "integer",
                "minimum": 1
              },
              "row_revision": {
                "type": "integer",
                "minimum": 1
              },
              "available": {
                "const": true
              },
              "disabled": {
                "const": false
              },
              "confirmed_by_operator": {
                "type": "boolean"
              },
              "expiry_known": {
                "type": "boolean"
              },
              "expires_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "type",
              "generation",
              "available",
              "expiry_known",
              "expires_at"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "app",
        "shop"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "identity",
    "credentials",
    "status"
  ],
  "additionalProperties": false
}
